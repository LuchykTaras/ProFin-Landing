# Vercel -> Project -> Settings -> Environment Variables

# Секретний токен від BotFather.
# НІКОЛИ не вставляти його в index.html або script.js.
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_REAL_BOT_TOKEN

# ID Telegram-групи, куди бот надсилатиме ліди.
# Для супергрупи зазвичай має вигляд -1001234567890
TELEGRAM_CHAT_ID=-1001234567890

# Необов'язково: якщо у групі використовуються Topics.
# TELEGRAM_MESSAGE_THREAD_ID=123

# Рекомендовано для production.
# Кілька доменів можна вказати через кому.
ALLOWED_ORIGINS=https://pro-fin-landing.vercel.app
